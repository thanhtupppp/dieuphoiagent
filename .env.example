# Dieuphoiagent environment overrides
# Copy this file to .env for local development. Never commit real secrets.

# Browser/CDP
DIEUPHOI_CDP_URL=http://localhost:9222
DIEUPHOI_CDP_PORT=9222
DIEUPHOI_BROWSER_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
DIEUPHOI_DEDICATED_PROFILE_DIR=browser_profile

# Orchestration
DIEUPHOI_MAX_LOOPS=5
DIEUPHOI_TIMEOUT_SECONDS=600
DIEUPHOI_TEXT_STABILITY_SECONDS=2.5
DIEUPHOI_RECONNECT_ATTEMPTS=3
DIEUPHOI_RECONNECT_DELAY_SECONDS=2.0

# API credentials are intentionally placeholders only.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
