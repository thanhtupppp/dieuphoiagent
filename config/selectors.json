{
  "perplexity": {
    "url_match": "perplexity.ai",
    "input_textarea": "#ask-input:visible, div[contenteditable='true']:visible, textarea:visible",
    "send_button": "button[aria-label='Submit']:visible, button[aria-label*='Submit']:visible, button:has(svg.lucide-arrow-right):visible",
    "stop_button": "button[aria-label*='Stop response']:visible, button:has-text('Stop'):visible, button[aria-label*='Stop']:visible",
    "last_response": "div[data-testid='answer-content'], div.prose, div.default",
    "action_buttons": "button[aria-label*='Copy']:visible, button[aria-label*='Sao chép']:visible"
  },
  "chatgpt": {
    "url_match": "chatgpt.com",
    "prompt_textarea": "div#prompt-textarea:visible, [contenteditable='true']:visible",
    "send_button": "button[data-testid='send-button']:visible",
    "stop_button": "button[data-testid='stop-button']:visible, button[aria-label*='Dừng trả lời']:visible",
    "last_response": "div[data-message-author-role='assistant']",
    "action_buttons": "button[data-testid='copy-turn-action-button']:visible, button[data-testid='feedback-turn-action-button']:visible",
    "tool_running_indicator": "div[data-testid*='tool-call-running']:visible"
  }
}
