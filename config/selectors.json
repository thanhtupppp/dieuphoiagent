{
  "perplexity": {
    "url_match": "perplexity.ai",
    "input_textarea": "#ask-input, div[contenteditable='true'], textarea",
    "send_button": "button[aria-label*='Gửi'], button[aria-label*='Submit'], button[aria-label*='Send'], button[type='submit']",
    "stop_button": "button[aria-label*='Stop response'], button[aria-label*='Stop'], button[aria-label*='Dừng']",
    "last_response": "div[data-testid='answer-content'], div.prose, div.default",
    "action_buttons": "button[aria-label*='Copy'], button[aria-label*='Sao chép'], button[aria-label*='Chia sẻ']"
  },
  "chatgpt": {
    "url_match": "chatgpt.com",
    "prompt_textarea": "div#prompt-textarea, [contenteditable='true']",
    "send_button": "button[data-testid='send-button'], button#composer-submit-button, button[aria-label*='Gửi'], button[aria-label*='Send']",
    "stop_button": "button[data-testid='stop-button'], button[aria-label*='Dừng'], button[aria-label*='Stop']",
    "last_response": "div[data-message-author-role='assistant']",
    "action_buttons": "button[data-testid='copy-turn-action-button'], button[data-testid='feedback-turn-action-button'], button[aria-label*='Sao chép']",
    "tool_running_indicator": "div[data-testid*='tool-call-running']"
  }
}
